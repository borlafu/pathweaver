# Unity generated directories
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]in/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Unity3D generated project files. Unity regenerates these; never hand-edit or commit them.
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln

# Hand-authored .NET projects outside Assets/ are real source and must be tracked.
# Pathweaver.slnx is the solution; the legacy *.sln pattern above does not match it.
!/src/**/*.csproj
!/tests/**/*.csproj
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated crash report
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.DotSettings.user

# Gradle output from Android export
*.gradle/
local.properties

# Play signing material — never commit, anywhere, for any reason.
#
# There are deliberately no exceptions here. An earlier version of this file
# un-ignored keystores under Assets/, copying the pattern used for Unity .meta
# files, which meant a keystore placed in the Unity project would have been
# committed silently. Unity's own Keystore Manager will happily create one inside
# the project, so that exception was pointed straight at the likeliest mistake.
*.keystore
*.jks
*.p12
*.pepk
keystore.properties
*.aab

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Local secrets and environment
.env
.env.local

# Per-developer Claude Code settings
.claude/settings.local.json

# Pathweaver.Core is built into the Unity project by scripts/build-core.sh.
# It is a build output, so it is not committed; run the script on a fresh clone.
/Assets/Plugins/Pathweaver.Core.dll
/Assets/Plugins/Pathweaver.Core.dll.meta

# Levels are copied from levels/ into Resources by scripts/build-core.sh.
/Assets/Resources/Levels/
/Assets/Resources/Levels.meta

# Rendered previews from ProjectBootstrap.CaptureBoardPreview
/Artifacts/

# IL2CPP scratch space from an Android build
/.utmp/
