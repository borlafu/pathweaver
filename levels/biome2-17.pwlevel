# Biome 2, level 17 — Contested Ground
#
# Two routes whose corridors run into the same part of the board from different sides, each turning
# twice to get through it. They do not share a cell — a cell holds one tile and one kind, so a shared
# cell would make one route impossible rather than difficult — but they share the room.
#
# What they contest is attention. The two work sites overlap on screen, so this is the one board in
# the biome where both routes are visible at once, and the temptation is to build them together and
# finish neither.
#
# Edge directions run clockwise on screen from due east: 0 east, 1 south-east, 2 south-west, 3 west,
# 4 north-west, 5 north-east.

id: biome2-17
name: Contested Ground

base-score: 100

# Nothing here clears it alone: the long corridor pays 448, the short one 332 and the wind drop
# 182. The cheapest pair is the long corridor and the drop at 630, and all three reach 962. This is
# the board in the biome that has to be finished twice.
target-score: 600

tokens: 1
skips: 3

seed: 89

# 26 cells, 11.7 by 10.0 world units.
cell: -7,0
cell: -6,0
cell: -5,0
cell: -4,0
cell: -4,1
cell: -4,2
cell: -3,2
cell: 2,-7
cell: 2,-6
cell: 2,-5
cell: 2,-4
cell: 1,-3
cell: 0,-2
cell: 0,-1
cell: 0,0
cell: 2,1
cell: 2,2
cell: 2,3
cell: 2,4
cell: 2,5
cell: -7,1
cell: -2,2
cell: 3,-7
cell: 1,0
cell: 3,1
cell: 3,5

spring: -7,0 water
hub: -3,2 water
spring: 2,-7 crystal
hub: 0,0 crystal
spring: 2,1 wind
hub: 2,5 wind

# Straights with two bends each for the corridors that turn, and straights for the drop. Slack of
# three per shape, because a board that must be finished twice cannot also punish a bad draw.
tile: 0,2 crystal x5
tile: 0,3 crystal x7
tile: 0,2 water x5
tile: 0,3 water x6
tile: 0,3 wind x6


# The board's own solution, replayed by the solvability gate rather than searched for. The search
# exhausted six hundred thousand states here without a verdict: what costs it is open space rather
# than cell count, and a board with room to travel is a board with room to search.
#
# It reaches 630 against a target of 600 in 13 moves. None of its three skips are spent.
#
# Rotations are written down. They are optional in the format, but a spur will accept the wrong one
# legally and a corner will not accept the right one twice.

solve: 2,2 rot 1
solve: -6,0 rot 0
solve: 2,-6 rot 1
solve: -5,0 rot 0
solve: 2,3 rot 1
solve: 2,-5 rot 1
solve: 2,-4 rot 2
solve: 1,0 rot 1
solve: 2,4 rot 1
solve: 1,-3 rot 2
solve: -4,0 rot 1
solve: 0,-1 rot 1
solve: 0,-2 rot 5
