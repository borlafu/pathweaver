# Biome 2, level 3 — The Wheel
#
# Three straight spokes from one chamber, each five conduits long, each a different resource. The hubs
# sit together at the middle and the springs sit at the rim, so a route is built inward — which is the
# reverse of every board before it, where the player works outward from a spring.
#
# The chamber is the whole idea. Its empty centre cell touches all three hubs, so any kind may be
# placed there and none of them should be: it is the one cell on the board that looks like the most
# connected place and is in fact a dead end. A board wants somewhere plausible to waste a tile.
#
# Spokes rather than a sprawl because it makes the panning legible. There is no way to hold two spokes
# on screen at once at the default zoom, so the player finishes one and travels, rather than drifting.
#
# Edge directions run clockwise on screen from due east: 0 east, 1 south-east, 2 south-west, 3 west,
# 4 north-west, 5 north-east.

id: biome2-03
name: The Wheel

base-score: 100

# Two spokes clear it. Five conduits pay 332, so two are 664 against this and all three are 996 —
# which leaves the third spoke as the reason to keep playing a board already won.
target-score: 600

tokens: 1
skips: 3

seed: 23

cell: 1,0
cell: 2,0
cell: 3,0
cell: 4,0
cell: 5,0
cell: 6,0
cell: 7,0
cell: -1,1
cell: -2,2
cell: -3,3
cell: -4,4
cell: -5,5
cell: -6,6
cell: -7,7
cell: 0,-1
cell: 0,-2
cell: 0,-3
cell: 0,-4
cell: 0,-5
cell: 0,-6
cell: 0,-7
cell: 0,0
cell: 2,-1
cell: 5,1
cell: -3,2
cell: -5,6
cell: 1,-3
cell: 1,-5

hub: 1,0 water
spring: 7,0 water
hub: -1,1 crystal
spring: -7,7 crystal
hub: 0,-1 wind
spring: 0,-7 wind

# Straights only, which every cell of every spoke wants, plus one bend per kind for the spurs to
# tempt with. A bend at 2,-1 joins the water hub and the conduit beside it and shortens the route it
# is part of, which is a mistake the board lets a player make and a Pivot Token lets them take back.
tile: 0,3 water x7
tile: 0,2 water x1
tile: 0,3 crystal x7
tile: 0,2 crystal x1
tile: 0,3 wind x7
tile: 0,2 wind x1
