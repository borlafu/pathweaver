spring: -4,-5 water
hub: -8,3 water
spring: 1,-5 wind
hub: -3,3 wind
spring: 6,-5 crystal
hub: 2,3 crystal

# Bends only, in three kinds. A river accepts any bend of its own colour, so the skip control is
# here for the wrong kind rather than the wrong shape.
tile: 0,2 crystal x8
tile: 0,2 water x8
tile: 0,2 wind x8


# The board's own solution, replayed by the solvability gate rather than searched for. The search
# exhausted six hundred thousand states here without a verdict: what costs it is open space rather
# than cell count, and a board with room to travel is a board with room to search.
#
# It reaches 1,210 against a target of 800 in 20 moves. None of its three skips are spent.
#
# Rotations are written down. They are optional in the format, but a spur will accept the wrong one
# legally and a corner will not accept the right one twice.

solve: -4,-4 rot 2
solve: -5,-3 rot 5
solve: 1,-4 rot 2
solve: 6,-4 rot 2
solve: 5,-3 rot 5
solve: 5,-2 rot 2
solve: 0,-3 rot 5
