# Biome 2, level 11 — The Cistern Walk
#
# Two long walks that each turn once and then straighten again, with a short wind drop between them
# for a player who wants the target quickly rather than the score.
#
# The short route is the interesting one. It is three conduits against the walks' seven, so it pays
# a sixth of what they do — and it is the only thing on the board reachable without a journey. A
# board that offers a cheap option and an expensive one is a board with a decision in it.
#
# Edge directions run clockwise on screen from due east: 0 east, 1 south-east, 2 south-west, 3 west,
# 4 north-west, 5 north-east.

id: biome2-11
name: The Cistern Walk

base-score: 100

# One walk plus the wind drop reaches 787. Both walks reach 1,210.
target-score: 750

tokens: 1
skips: 3

seed: 61

# 29 cells, 12.6 by 8.5 world units.
cell: -5,-3
cell: -4,-3
cell: -3,-3
cell: -2,-3
cell: -2,-2
cell: -2,-1
cell: -2,0
cell: -1,0
cell: 0,0
cell: 4,4
cell: 3,4
cell: 2,4
cell: 1,4
cell: 1,3
cell: 1,2
cell: 1,1
cell: 0,1
cell: -1,1
cell: 0,-6
cell: 0,-5
cell: 0,-4
cell: 0,-3
cell: 0,-2
cell: -5,-2
cell: 1,0
cell: 5,4
cell: -1,2
cell: 1,-6
cell: 1,-2

spring: -5,-3 water
hub: 0,0 water
spring: 4,4 crystal
hub: -1,1 crystal
spring: 0,-6 wind
hub: 0,-2 wind

# Straights for the walks with one bend each for their corners, and straights for the drop.
tile: 0,2 crystal x4
tile: 0,3 crystal x7
tile: 0,2 water x4
tile: 0,3 water x7
tile: 0,3 wind x5


# The board's own solution, replayed by the solvability gate rather than searched for. The search
# exhausted six hundred thousand states here without a verdict: what costs it is open space rather
# than cell count, and a board with room to travel is a board with room to search.
#
# It reaches 787 against a target of 750 in 20 moves. None of its three skips are spent.
#
# Rotations are written down. They are optional in the format, but a spur will accept the wrong one
# legally and a corner will not accept the right one twice.

solve: -5,-2 rot 2
solve: 0,-5 rot 1
solve: 3,4 rot 0
solve: -4,-3 rot 0
solve: -3,-3 rot 0
solve: 0,-4 rot 1
solve: -1,0 rot 0
solve: -1,2 rot 2
solve: 2,4 rot 0
solve: -2,-3 rot 1
solve: 0,1 rot 0
solve: -2,-2 rot 1
solve: 5,4 rot 0
solve: 0,-3 rot 1
solve: 1,-6 rot 0
solve: 1,4 rot 4
solve: 1,1 rot 1
solve: 1,3 rot 1
solve: -2,0 rot 4
solve: 1,2 rot 1
