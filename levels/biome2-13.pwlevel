# Biome 2, level 13 — The Split Ridge
#
# A descent down the middle with two spurs leaving it east and south, so the board is one long
# journey with two short errands hanging off it.
#
# Three routes of three different lengths, which is what makes the order matter: the descent pays
# most and costs most, and a player who builds it first spends the rest of the board holding tiles
# for routes they have already finished.
#
# Edge directions run clockwise on screen from due east: 0 east, 1 south-east, 2 south-west, 3 west,
# 4 north-west, 5 north-east.

id: biome2-13
name: The Split Ridge

base-score: 100

# The descent alone pays 605; with either spur it clears. All three reach 1,183.
target-score: 780

tokens: 1
skips: 3

seed: 71

# 26 cells, 10.4 by 9.2 world units.
cell: 0,-6
cell: -1,-5
cell: -1,-4
cell: -2,-3
cell: -2,-2
cell: -3,-1
cell: -3,0
cell: -4,1
cell: -4,2
cell: -6,3
cell: -5,3
cell: -4,3
cell: -3,3
cell: -2,3
cell: 3,0
cell: 3,1
cell: 3,2
cell: 3,3
cell: 3,4
cell: 3,5
cell: 1,-6
cell: -3,2
cell: -6,4
cell: -1,3
cell: 4,0
cell: 4,5

spring: 0,-6 water
hub: -4,2 water
spring: -6,3 wind
hub: -2,3 wind
spring: 3,0 crystal
hub: 3,5 crystal

# Bends for the descent, straights for the two spurs.
tile: 0,3 crystal x5
tile: 0,2 water x8
tile: 0,3 wind x4


# The board's own solution, replayed by the solvability gate rather than searched for. The search
# exhausted six hundred thousand states here without a verdict: what costs it is open space rather
# than cell count, and a board with room to travel is a board with room to search.
#
# It reaches 1,033 against a target of 780 in 16 moves. None of its three skips are spent.
#
# Rotations are written down. They are optional in the format, but a spur will accept the wrong one
# legally and a corner will not accept the right one twice.

solve: -1,-5 rot 5
solve: -1,-4 rot 2
solve: 3,1 rot 1
solve: 3,2 rot 1
solve: -5,3 rot 0
solve: 3,3 rot 1
solve: 3,4 rot 1
solve: -2,-3 rot 5
solve: -2,-2 rot 2
solve: -3,-1 rot 5
solve: -4,3 rot 0
solve: -3,0 rot 2
solve: 4,0 rot 0
solve: -3,3 rot 0
solve: -6,4 rot 1
