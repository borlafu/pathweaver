# Biome 2, level 1 — The Long Valley
#
# The first board that has to be navigated rather than read. It opens showing all of itself, settles
# near the water spring in the north, and is panned from there.
#
# Sized deliberately. An earlier draft was only about a third wider than a biome-one board, which left
# the pan 0.86 world units of slack horizontally and none at all vertically — a vertical drag moved
# nothing, because the default zoom fits a hexagon-3 board by its width and a portrait phone then has
# two and a half times more vertical room than such a board needs. This one is wide and tall enough
# that both axes have somewhere to go.
#
# Three pairs, far apart, each needing four or five conduits — rather than one enormous route. A
# sixteen-conduit forced line down the spine would score absurdly and play as sixteen placements with
# no decision in them. Separate work sites are also what makes panning meaningful: the player travels
# between them.
#
# Sprawling rather than crowded, at fifty-five open cells over that footprint. Open space is what makes
# the solvability search explode, which is why this level carries its own solution instead.

id: biome2-01
name: The Long Valley

base-score: 100

# Two of the three pairs clear it. Water pays most for the fewest tiles, so the choice is which of the
# two long straight runs to spend the board on.
target-score: 550

tokens: 1
skips: 3

seed: 7

# The valley floor: a north-west chamber, a spine down the middle, a trunk running east, and
# spurs west and south.
cell: -3,-7
cell: -3,-6
cell: -2,-8
cell: -2,-7
cell: -2,-6
cell: -1,-8
cell: -1,-7
cell: -2,-5
cell: -3,-4
cell: -3,-3
cell: -4,-2
cell: -4,-1
cell: -5,0
cell: -5,-3
cell: -5,-2
cell: -6,-1
cell: -6,0
cell: -7,1
cell: -7,2
cell: -8,3
cell: -8,4
cell: -9,5
cell: -9,6
cell: -10,7
cell: -10,8
cell: -11,9
cell: -4,-3
cell: -2,-3
cell: -1,-3
cell: 0,-3
cell: 1,-3
cell: 2,-3
cell: 3,-3
cell: 4,-3
cell: 4,-2
cell: 4,-1
cell: 4,0
cell: 4,1
cell: 4,2
cell: 4,3
cell: 3,3
cell: 3,4
cell: 4,4
cell: 5,2
cell: 5,3
cell: -12,9
cell: -12,10
cell: -11,8
cell: -11,10
cell: -10,9
cell: -9,3
cell: -10,3
cell: -11,3
cell: -12,3
cell: -13,3

spring: -2,-6 water
hub: -5,0 water
spring: -2,-3 wind
hub: 3,-3 wind
spring: -8,3 crystal
hub: -13,3 crystal

# Water wants five of the same bend; wind and crystal want four straights each. The rest is slack,
# because a corridor with no spare tile is a corridor a single unlucky draw ends.
tile: 0,2 water x7
tile: 0,3 water x2
tile: 0,3 wind x6
tile: 0,2 wind x1
tile: 0,3 crystal x6
tile: 0,2 crystal x1

# The board's own solution, replayed by the solvability gate rather than searched for. The search cannot
# finish on a board this size; see AuthoredSolution for what that trade costs.
#
# Rotations are written down. They are optional in the format, but this board has junctions, and at a
# junction more than one rotation joins something legally while only one continues the route.
#
# It completes all three pairs for 824 against a target of 550, using none of its three skips. A player
# only needs two of the three, so the solution shows the board's ceiling rather than the cheapest way
# through it.

solve: -7,2 rot 0
solve: -2,-5 rot 2
solve: -3,-4 rot 5
solve: -1,-3 rot 0
solve: -9,3 rot 0
solve: -3,-3 rot 2
solve: -3,-6 rot 0
solve: -10,3 rot 0
solve: -2,-7 rot 1
solve: -11,3 rot 0
solve: 0,-3 rot 0
solve: -12,3 rot 0
solve: -4,-2 rot 5
solve: -4,-1 rot 2
solve: -2,-8 rot 1
solve: 4,-3 rot 1
solve: 1,-3 rot 0
solve: -1,-7 rot 0
solve: -8,4 rot 1
solve: 2,-3 rot 0
