spring: -4,-4 water
hub: 0,-4 water
spring: -3,-1 wind
hub: 1,-1 wind
spring: -2,2 crystal
hub: 2,2 crystal
spring: -1,5 trade
hub: 3,5 trade

# Straights in four kinds. With four bags interleaved a player holds the wrong colour more often
# than not, which is what makes the walking matter.
tile: 0,3 crystal x5
tile: 0,3 trade x5
tile: 0,3 water x5
tile: 0,3 wind x5

# The board's own solution, replayed by the solvability gate rather than searched for. The search cannot
# finish on a board like this: what costs it is open space, and open space is what this biome is made of
# now — the routes are spines of islands rather than corridors, so almost every cell has somewhere legal
# to go.
#
# It reaches 546 against a target of 500 in 10 moves, spending 0 of its three skips.
#
# Rotations are written down. They are optional in the format, but on open ground several rotations join
# something legally at almost every cell and only one continues the route.

solve: -1,2 rot 0
solve: 0,2 rot 0
solve: -3,-4 rot 0
solve: -2,-1 rot 0
solve: -2,-4 rot 0
solve: -1,-4 rot 0
solve: -5,-4 rot 0
solve: -1,-1 rot 0
solve: 1,2 rot 0
solve: 0,-1 rot 0
